{
  "name": "dcs-engineering-station",
  "productName": "DCS Engineering Station",
  "version": "1.10.0",
  "description": "Offline DCS logic workbench (DITL + analog ABC sheets). Portable, no admin rights needed.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "prepare-ui": "node prepare-ui.js",
    "start": "npm run prepare-ui && electron .",
    "dist": "npm run prepare-ui && electron-builder --win portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "local.dcs.engineering.station",
    "productName": "DCS Engineering Station",
    "files": ["main.js", "preload.js", "ui/**"],
    "directories": { "output": "dist" },
    "win": {
      "target": [{ "target": "portable", "arch": ["x64"] }],
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": { "artifactName": "DCS-Engineering-Station-${version}-portable.exe" }
  }
}
