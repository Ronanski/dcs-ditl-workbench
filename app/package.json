{
  "name": "logic-sim",
  "productName": "Logic Sim",
  "version": "1.10.0",
  "description": "Logic Sim: offline DCS logic workbench (DITL + analog ABC sheets). Portable, no admin rights needed.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "prepare-ui": "node prepare-ui.js",
    "start": "npm run prepare-ui && electron .",
    "dist": "npm run prepare-ui && electron-builder --win portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "local.logicsim",
    "productName": "Logic Sim",
    "files": [
      "main.js",
      "preload.js",
      "ui/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": {
      "artifactName": "logic-sim-v${version}-portable.exe"
    },
    "copyright": "Copyright (c) 2026 Ronanski"
  },
  "author": {
    "name": "Ronanski"
  }
}
